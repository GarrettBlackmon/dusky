[Unit]
Description=WayVNC Server for Main Display
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/home/garrett/user_scripts/networking/vnc-wrapper.sh
Restart=on-failure
RestartSec=10s
# Prevent restart if display doesn't exist (clean exit)
RestartPreventExitStatus=0

[Install]
WantedBy=graphical-session.target
